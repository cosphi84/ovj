DATABASE_URL="postgresql://user:password@localhost:5432/dbName?sslmode=disable"
JWT_SECRET=aN529W1vnIStWVLZZTo9jnaz59RAU6O0buV1A4u7pVs

# Set subfolder path on web server. Misal, url adalah: http://domain.com/ovj, maka set /ovj, kosongkan jika ada di root
NEXT_PUBLIC_BASE_PATH="/ovj"

# Mailer Config
